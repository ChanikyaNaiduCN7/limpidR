\name{limpidR-package}
\alias{limpidR-package}
\alias{limpidR}
\docType{package}
\title{Reproducible Analysis of Freshwater Microplastic Data}
\description{
Tools for loading, validating, harmonizing, analysing, modelling and visualizing freshwater
microplastic datasets, with bundled synthetic demonstration tables that follow the LIMPID-India schema.
}
\details{
The package emphasizes explicit units, provenance, composition closure, grouped validation,
and transparent assumptions. Missing environmental values are not silently imputed.
}
\author{Chanikya Naidu <thefisherieschanikyaneeti@gmail.com>}
\keyword{package}
